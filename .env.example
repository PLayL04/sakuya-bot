# Токен бота: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# ID сервера: включите режим разработчика в Discord, ПКМ по серверу -> "Копировать ID сервера"
GUILD_ID=
# ID ролей, участники с которыми могут управлять ботом (ПКМ по роли в настройках сервера -> "Копировать ID роли").
# Можно несколько через запятую — достаточно любой из них: ADMIN_ROLE_ID=111111111111111111,222222222222222222
ADMIN_ROLE_ID=
# ID каналов, где работает !кофе (ПКМ по каналу -> "Копировать ID канала"), можно несколько через запятую.
# В остальных каналах команда молча игнорируется. Пусто — работает во всех каналах.
COFFEE_CHANNEL_ID=
# ID каналов для !пиво; если пусто — те же каналы, что и для !кофе
BEER_CHANNEL_ID=
# Часовой пояс, в котором указывается время в расписании
TIMEZONE=Europe/Moscow
