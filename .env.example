# Токен бота: https://discord.com/developers/applications -> Bot -> Reset Token
DISCORD_TOKEN=
# ID сервера: включите режим разработчика в Discord, ПКМ по серверу -> "Копировать ID сервера"
GUILD_ID=
# Папка с текстами для !цитата (файлы *.txt). Пусто — папка quotes/ рядом с bot.py
QUOTES_DIR=

# Роли управления, каналы развлекательных команд, кулдауны и часовой пояс настраиваются на сервере:
# /settings download -> исправить файл -> /settings upload (файл хранится в data/settings.toml).
# Ключи ниже нужны только для переноса старых настроек: из них файл создаётся при первом запуске.
# ADMIN_ROLE_ID=111111111111111111,222222222222222222
# FUN_CHANNEL_ID=
# TIMEZONE=Europe/Moscow
